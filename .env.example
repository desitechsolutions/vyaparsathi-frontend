# API base URL for the backend
REACT_APP_API_BASE_URL=http://localhost:8080

# Sentry DSN for production error tracking and monitoring.
# Obtain this from your Sentry project settings (Settings > Projects > <project> > DSN).
# Leave blank (or omit) in development; Sentry is only initialised when NODE_ENV=production.
REACT_APP_SENTRY_DSN=
