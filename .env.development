# For local dev, leave REACT_APP_API_BASE_URL empty so Axios uses relative paths.
# The CRA/CRACO dev server proxy (see package.json "proxy" field) forwards all
# /api/** requests to localhost:8080. This makes the refreshToken HttpOnly cookie
# visible on /api/auth/refresh — SameSite=Lax blocks cookies on cross-origin POST
# requests (3000→8080) but allows them on same-origin proxied requests.
REACT_APP_API_BASE_URL=
# WebSocket (SockJS) requires an absolute URL — it cannot use relative paths.
# Point to the dev server (3000) which setupProxy.js forwards to localhost:8080.
REACT_APP_WS_BASE_URL=http://localhost:3000
